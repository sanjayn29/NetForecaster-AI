# ==============================================================================
# NetForecaster AI — Official Git Ignore Configuration
# ==============================================================================

# ── Datasets & Large Data Files (Ignore all data binaries, preserve structure) ─
data/raw/*
data/processed/*
data/external/*
data/cache/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!data/cache/.gitkeep
*.parquet
*.feather
*.h5
*.hdf5
*.npz
*.npy
*.tar.gz
*.zip
*.7z
*.rar

# ── Python Caching & Bytecode ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
develop-eggs/
/dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Testing, Coverage & Scratch Scripts ──────────────────────────────────────
.pytest_cache/
pytest-cache-files-*/
.pytest_temp/
.tmp_pytest/
tests/_tmp/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
scratch/

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
*.pem
*.key
*.cert

# ── Logs & Operational Telemetry ─────────────────────────────────────────────
logs/*
!logs/.gitkeep
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Node / Frontend Dependencies & Cache ─────────────────────────────────────
node_modules/
app/frontend/node_modules/
app/frontend/.vite/
app/frontend/.turbo/
.npm/
.eslintcache

# Track pre-built frontend distribution for zero-dependency offline SOC dashboard launch
!app/frontend/dist/
!app/frontend/dist/**

# ── IDE, Editor & Operating System Files ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
Desktop.ini
